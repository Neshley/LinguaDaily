{
  "name": "react-example",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run verify:content && npm run audit:content && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:logic": "tsx scripts/test-logic.ts",
    "check": "npm run lint && npm run typecheck:node && npm run verify:content && npm run audit:content && npm run build",
    "content:export": "node scripts/export-content.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "audit:content": "node scripts/content-quality-audit.mjs",
    "content:generate": "node scripts/purge-untrusted-content.mjs && tsx scripts/generate-content.ts && node scripts/export-content.mjs && node scripts/verify-content.mjs && node scripts/content-quality-audit.mjs",
    "content:dedupe": "node scripts/dedupe-content.mjs",
    "content:purge-untrusted": "node scripts/purge-untrusted-content.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21",
    "@types/canvas-confetti": "^1.9.0"
  }
}
