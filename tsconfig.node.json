{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules"]
}
